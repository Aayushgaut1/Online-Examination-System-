# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Secret for user session tokens
JWT_SECRET="nexusexam_jwt_secret_key_2026"

# PostgreSQL / Supabase Database Connection
# Direct connection string for PostgreSQL / Supabase (e.g., postgres://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres or postgresql://...)
DATABASE_URL=
POSTGRES_URL=

# Supabase Client & Backend Configuration
VITE_SUPABASE_URL="https://jwnhapdvdsvwbyumtjun.supabase.co"
VITE_SUPABASE_ANON_KEY=

# Supabase API credentials (server-side)
SUPABASE_URL="https://jwnhapdvdsvwbyumtjun.supabase.co"
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL / Supabase Database Connection (optional direct connection)
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
